# ============================================================================
# ARX TESSERA (najialess.io) - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local/Docker usage, or add in Vercel Project Settings
# ============================================================================

# Server Ports (Docker / Local)
BACKEND_PORT=8082
FRONTEND_PORT=3002

# Email Routing Destination
CONTACT_RECIPIENT_EMAIL=alessionaji1@gmail.com
EMAIL_FROM="Arx Tessera Dispatch <onboarding@resend.dev>"

# ============================================================================
# CHOOSE YOUR EMAIL PROVIDER (OPTION A OR OPTION B):
# ============================================================================

# OPTION A (RECOMMENDED FOR VERCEL): Resend Transactional Email API
# 1. Sign up for free at https://resend.com (3,000 free emails/mo)
# 2. Generate an API Key at https://resend.com/api-keys
# 3. Paste the key below (starts with "re_"):
RESEND_API_KEY=

# OPTION B (ALTERNATIVE): Gmail / Google Workspace SMTP with App Password
# 1. Turn on 2-Step Verification on your Google Account (alessionaji1@gmail.com)
# 2. Go to: myaccount.google.com/apppasswords
# 3. Create an app password named "Arx Tessera"
# 4. Fill in the credentials below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alessionaji1@gmail.com
SMTP_PASS=

# Optional: Shared Secret for /api/inbound-email Webhooks (Cloudflare / Resend Inbound)
INBOUND_WEBHOOK_SECRET=

# Allowed CORS Origins for Backend on Port 8082
CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002,https://najialess.io,https://www.najialess.io
